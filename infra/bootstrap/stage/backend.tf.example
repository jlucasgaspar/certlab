# Copy to backend.tf (ignored by Git) after the first apply, then run:
#   terraform init -migrate-state -backend-config=backend.local.hcl
# The bucket name comes from backend.local.hcl, which is also ignored by Git.
terraform {
  backend "s3" {
    key          = "bootstrap/stage/terraform.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }
}
